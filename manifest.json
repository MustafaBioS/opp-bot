{
  "display_information": {
    "name": "opp-bot"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "opp-bot",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/opportunity",
        "description": "Submit an opportunity to #hc-opportunities",
        "usage_hint": "[title]",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": ["channels:history", "chat:write", "im:history", "groups:history", "reactions:read", "commands"]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": ["message.channels", "message.groups", "message.im", "reaction_added"]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": true,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
